#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int stage = 1;
int player_alive = 1;
int level = 1;
int xp = 0;
int xp_needed = 20;
int skill_points = 0;
int gold = 0;
int max_hp = 100;
int hp = 100;
int max_stamina = 50;
int stamina = 50;
int attack = 10;
int defense = 5;
int speed = 5;
int health_potions = 3;

// functions

void normal_stage();
void npc_event();
void enemy_fight();
void boss_fight();
void shop();
void level_up();
void show_stats();
void game_over();

int main()
{
    srand(time(NULL));
    printf("\nWelcome to the Endless RPG Game!\n");

    while(player_alive)
    {
        printf("\n===============================\n");
        printf("STAGE %d\n", stage);
        printf("===============================\n");

        show_stats();

        // boss
        if(stage % 10 == 0)
        {
            boss_fight();
        }

        // shop
        else if(stage % 10 == 9)
        {
            shop();
        }

        // normal stage
        else
        {
            normal_stage();
        }

        if(hp <= 0)
        {
            player_alive = 0;
            break;
        }

        while(xp >= xp_needed)
        {
            level_up();
        }

        stage++;
    }

    game_over();

    return 0;
}